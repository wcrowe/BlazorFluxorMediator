@page "/weather"

@rendermode InteractiveWebAssembly
<Fluxor.Blazor.Web.StoreInitializer />

@* @rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
<Fluxor.Blazor.Web.StoreInitializer />
 *@




@* @rendermode @(new InteractiveWebAssemblyRenderMode(false))
@* @rendermode InteractiveServer // Ensure component runs interactively *@
@* @rendermode InteractiveAuto *@
@inherits FluxorComponent // Inherit from FluxorComponent for automatic state subscription management

@inject IState<WeatherState> WeatherState // Inject the specific state slice @inject IDispatcher Dispatcher // Inject the dispatcher to send actions
@inject IDispatcher Dispatcher
@inject ILogger<Weather> logger
<PageTitle>Weather</PageTitle>

<h1>Weather Forecast (Fluxor + MediatR)</h1>

<p>This component demonstrates fetching data using Fluxor for state management and MediatR for handling the fetch logic.</p>

<button class="btn btn-primary" @onclick="FetchData" disabled="@WeatherState.Value.IsLoading">
    @if (WeatherState.Value.IsLoading)
    {
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span> Loading...</span>
    }
    else
    {
        <span>Fetch Weather</span>
    }
</button>

@if (WeatherState.Value.Forecasts is not null && !WeatherState.Value.IsLoading) {
    <table class="table mt-3">
        <thead>
            <tr>
                <th>Date</th>
                <th>Temp. (C)</th>
                <th>Temp. (F)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in WeatherState.Value.Forecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.TemperatureF</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (!string.IsNullOrEmpty(WeatherState.Value.ErrorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">
        <strong>Error:</strong> @WeatherState.Value.ErrorMessage
    </div>
}
else if (!WeatherState.Value.IsLoading)
{
    <p class="mt-3"><em>Click the button to load weather data.</em></p> }


@code {
    private void FetchData()
    {
        // Dispatch the action that the Effect is listening for
        Dispatcher.Dispatch(new FetchWeatherAction());
        logger.LogDebug("After dispatcth");
    }

    // private bool _initialized = false; // ✅ Prevents duplicate calls

